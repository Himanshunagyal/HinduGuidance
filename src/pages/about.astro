---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="About Us - HinduGuidance"
  description="Learn about HinduGuidance — your trusted digital Hindu spiritual guide for vrat calendars, muhurat timings, and AI Pandit guidance rooted in Vedic tradition."
>
  <Header />

  <div class="bg-gradient-to-b from-darkbrown to-deepred text-cream py-14">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h1 class="font-display text-4xl md:text-5xl font-semibold mb-3">About Us</h1>
      <p class="text-cream/60 font-body text-lg">Rooted in dharma, built for the modern devotee</p>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-16 prose prose-lg">
    <div class="card-sacred p-8 mb-8">
      <div class="text-center mb-6">
        <span class="text-5xl">🕉️</span>
        <h2 class="font-display text-3xl text-darkbrown font-semibold mt-4">Our Mission</h2>
      </div>
      <p class="font-body text-darkbrown/75 leading-relaxed">
        HinduGuidance was created with one simple purpose — to make authentic Hindu spiritual guidance accessible to every devotee, wherever they are. In today's busy world, it can be difficult to find reliable information about vrat rules, puja procedures, auspicious timings, and festival schedules.
      </p>
      <p class="font-body text-darkbrown/75 leading-relaxed mt-4">
        We bridge the gap between ancient Vedic wisdom and modern life by providing a clean, easy-to-use platform where anyone can find the spiritual guidance they need — at any hour of the day.
      </p>
    </div>

    <div class="card-sacred p-8 mb-8">
      <h2 class="font-display text-2xl text-darkbrown font-semibold mb-4">What We Offer</h2>
      <ul class="space-y-3 font-body text-darkbrown/75">
        <li class="flex gap-3"><span class="text-saffron-500">🪷</span> <span><strong>Vrat Calendar</strong> — Detailed fasting guides for Ekadashi, Pradosh, Navratri, Sankashti and more with dates, rules and food lists.</span></li>
        <li class="flex gap-3"><span class="text-saffron-500">⏰</span> <span><strong>Muhurat Finder</strong> — Auspicious timings for marriage, grihapravesh, naming ceremonies and all important life events.</span></li>
        <li class="flex gap-3"><span class="text-saffron-500">🙏</span> <span><strong>AI Pandit Shivananda</strong> — An AI guide trained on Vedic scriptures to answer your spiritual questions with warmth and authenticity.</span></li>
      </ul>
    </div>

    <div class="card-sacred p-8 mb-8">
      <h2 class="font-display text-2xl text-darkbrown font-semibold mb-4">Our Commitment</h2>
      <p class="font-body text-darkbrown/75 leading-relaxed">
        All content on HinduGuidance is researched carefully to reflect authentic Hindu traditions. We respect the diversity of regional practices across India and the Hindu diaspora worldwide. Our AI Pandit is designed to give guidance in the spirit of dharma — always advising users to consult a local pandit for major life decisions.
      </p>
      <p class="font-body text-darkbrown/75 leading-relaxed mt-4 text-center italic text-saffron-700">
        "Dharmo Rakshati Rakshitah" — Dharma protects those who protect it.
      </p>
    </div>

    <div class="text-center">
      <a href="/contact" class="bg-saffron-600 text-white font-sans font-medium px-6 py-3 rounded-sm hover:bg-saffron-700 transition-colors inline-block">
        Get in Touch
      </a>
    </div>
  </div>

  <Footer />
</BaseLayout>
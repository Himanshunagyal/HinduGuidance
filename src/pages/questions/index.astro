---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { questions } from '../../content/questions/data';
import { festivals } from '../../content/festivals/data';

export const prerender = true;

// Group questions by category based on their slug patterns
const categorizedQuestions = {
  "Diwali": questions.filter(q => q.slug.startsWith("why-is-diwali") || q.slug.startsWith("what-are-the-5-days") || q.slug.startsWith("who-started-diwali") || q.slug.startsWith("why-do-we-light-diyas") || q.slug.startsWith("why-is-lakshmi-puja")),
  "Hinduism": questions.filter(q => q.slug.startsWith("why-do-hindus") || q.slug === "hinduism" || q.slug.startsWith("why-hindus")),
  "Temple & Worship": questions.filter(q => q.slug.startsWith("why-remove-shoes") || q.slug.startsWith("why-do-we-ring-bells") || q.slug.startsWith("why-is-prasad") || q.slug.startsWith("why-is-camphor") || q.slug.startsWith("why-is-tulsi")),
  "Mantras": questions.filter(q => q.slug.startsWith("why-chant") || q.slug.startsWith("what-is-maha") || q.slug.startsWith("why-is-hanuman") || q.slug.startsWith("can-we-chant") || q.slug.startsWith("how-many-times")),
  "Fasting": questions.filter(q => q.slug.startsWith("why-is-ekadashi") || q.slug.startsWith("why-do-people-fast") || q.slug.startsWith("can-we-drink-water") || q.slug.startsWith("why-is-nirjala") || q.slug.startsWith("benefits-of-ekadashi")),
  "Festivals": questions.filter(q => q.slug.startsWith("why-is-holi") || q.slug.startsWith("why-is-raksha") || q.slug.startsWith("why-is-janmashtami") || q.slug.startsWith("why-is-ganesh") || q.slug.startsWith("why-is-navratri"))
};

// Remove empty categories
Object.keys(categorizedQuestions).forEach(key => {
  if (categorizedQuestions[key].length === 0) {
    delete categorizedQuestions[key];
  }
});

const totalQuestions = questions.length;

// Extract all unique keywords for meta tags
const allKeywords = [...new Set(questions.flatMap(q => q.keywords.split(', ')))].slice(0, 20).join(', ');

// Generate breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://hindupad.com/" },
    { "@type": "ListItem", "position": 2, "name": "Hindu Religious Questions & Answers", "item": "https://hindupad.com/questions" }
  ]
};

// Generate collection page schema
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Hindu Religious Questions & Answers",
  "description": "Comprehensive collection of answers to common Hindu religious questions about festivals, rituals, mantras, fasting, and temple worship.",
  "url": "https://hindupad.com/questions",
  "numberOfItems": totalQuestions
};
---

<BaseLayout
  title="Hindu Religious Questions & Answers - Understand Your Faith Better"
  description="Find answers to the most common Hindu religious questions. Why do Hindus worship cows? Why is Diwali celebrated? Significance of mantras, fasting, temple rituals, and more. Expert answers with scriptural references."
  keywords={allKeywords}
  schema={[breadcrumbSchema, collectionPageSchema]}
>
  <Header />

  <div class="max-w-6xl mx-auto px-4 pt-6 pb-2">
    <nav class="text-xs font-sans text-darkbrown/50 flex items-center gap-2">
      <a href="/" class="hover:text-saffron-600">Home</a>
      <span>›</span>
      <span class="text-darkbrown/80">Questions & Answers</span>
    </nav>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-10">

    <!-- Header Section with SEO-focused H1 -->
    <div class="text-center mb-12">
      <span class="text-6xl mb-4 inline-block">🕉️</span>
      <h1 class="font-display text-4xl md:text-5xl text-darkbrown font-semibold mb-4">
        Hindu Religious Questions & Answers
      </h1>
      <p class="text-darkbrown/65 font-body text-lg max-w-3xl mx-auto">
        Explore the spiritual wisdom behind Hindu traditions, rituals, mantras, and festivals. 
        Find scripturally-grounded answers to common questions about <strong class="text-saffron-700">why Hindus practice certain rituals</strong>, 
        the <strong class="text-saffron-700">significance of festivals like Diwali and Holi</strong>, 
        and the <strong class="text-saffron-700">power of Vedic mantras and fasting</strong>.
      </p>
      <div class="inline-flex items-center gap-2 mt-4 bg-saffron-50 px-4 py-2 rounded-full">
        <span class="text-saffron-600 text-sm font-medium">{totalQuestions}+ Questions Answered</span>
        <span class="text-darkbrown/30">•</span>
        <span class="text-saffron-600 text-sm font-medium">Based on Vedas & Puranas</span>
        <span class="text-darkbrown/30">•</span>
        <span class="text-saffron-600 text-sm font-medium">Regularly Updated</span>
      </div>
    </div>

    <!-- Search Bar with SEO-friendly placeholder -->
    <div class="mb-10">
      <div class="relative max-w-md mx-auto">
        <input 
          type="text" 
          id="searchQuestions"
          placeholder="Search: Diwali significance, cow worship, Hanuman Chalisa, Ekadashi fasting..."
          class="w-full px-5 py-3 border border-saffron-200 rounded-full font-body text-sm focus:outline-none focus:border-saffron-400 focus:ring-2 focus:ring-saffron-100"
          aria-label="Search questions about Hindu religion, rituals, festivals, and mantras"
        />
        <span class="absolute right-4 top-1/2 -translate-y-1/2 text-darkbrown/40">🔍</span>
      </div>
    </div>

    <!-- Quick Navigation Links (Anchor Links for SEO) -->
    <div class="flex flex-wrap justify-center gap-2 mb-10">
      {Object.keys(categorizedQuestions).map(category => (
        <a 
          href={`#${category.toLowerCase().replace(/ /g, '-')}`}
          class="px-4 py-2 bg-saffron-50 text-saffron-700 text-sm font-medium rounded-full hover:bg-saffron-100 transition-colors"
        >
          {category}
        </a>
      ))}
      <a href="#popular-questions" class="px-4 py-2 bg-saffron-50 text-saffron-700 text-sm font-medium rounded-full hover:bg-saffron-100 transition-colors">
        ⭐ Popular
      </a>
    </div>

    <!-- Questions by Category -->
    {Object.entries(categorizedQuestions).map(([category, catQuestions]) => (
      <section id={category.toLowerCase().replace(/ /g, '-')} class="mb-12 scroll-mt-24">
        <div class="flex items-center gap-3 mb-6 pb-2 border-b-2 border-saffron-200">
          <span class="text-3xl">
            {category === "Diwali" && "🪔"}
            {category === "Hinduism" && "🕉️"}
            {category === "Temple & Worship" && "🛕"}
            {category === "Mantras" && "🔊"}
            {category === "Fasting" && "🍽️"}
            {category === "Festivals" && "🎉"}
          </span>
          <h2 class="font-display text-2xl md:text-3xl text-darkbrown font-semibold">
            {category}
          </h2>
          <span class="text-saffron-600 text-sm bg-saffron-50 px-2 py-0.5 rounded-full">
            {catQuestions.length}
          </span>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {catQuestions.map((q) => (
            <a 
              href={`/questions/${q.slug}`}
              class="card-sacred p-5 hover:border-saffron-400 hover:bg-saffron-50/30 transition-all duration-200 group"
              aria-label={`Read answer to: ${q.title}`}
            >
              <div class="flex items-start gap-3">
                <span class="text-3xl">{q.icon}</span>
                <div class="flex-1">
                  <h3 class="font-display text-darkbrown font-semibold text-base mb-2 group-hover:text-saffron-700 transition-colors">
                    {q.title}
                  </h3>
                  <p class="text-darkbrown/55 font-body text-xs line-clamp-2">
                    {q.shortDesc.substring(0, 100)}...
                  </p>
                  <div class="mt-2 flex items-center gap-1 text-saffron-600 text-xs font-medium">
                    <span>Read Answer →</span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- Popular Questions Section with Internal Links -->
    <section id="popular-questions" class="my-12 card-sacred p-6 bg-gradient-to-r from-saffron-50/50 to-transparent scroll-mt-24">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-3xl">⭐</span>
        <h2 class="font-display text-2xl text-darkbrown font-semibold">Most Popular Questions</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-3">
        {questions.slice(0, 10).map((q) => (
          <a 
            href={`/questions/${q.slug}`}
            class="flex items-center gap-3 p-3 rounded-sm hover:bg-saffron-50 transition-colors group"
          >
            <span class="text-2xl">{q.icon}</span>
            <span class="font-body text-darkbrown/75 text-sm group-hover:text-saffron-700 flex-1">
              {q.title}
            </span>
            <span class="text-saffron-600 opacity-0 group-hover:opacity-100 transition-opacity">→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Cross-Linking: Related Festivals -->
    <section class="my-12 card-sacred p-6 bg-saffron-50/20">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-3xl">📅</span>
        <h2 class="font-display text-2xl text-darkbrown font-semibold">Explore Related Festival Guides</h2>
      </div>
      <p class="text-darkbrown/60 text-sm mb-4">Understanding the <strong class="text-saffron-700">why behind festivals</strong> enhances your celebration. Check out our detailed festival guides:</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {festivals.slice(0, 8).map((festival) => (
          <a 
            href={`/festivals/${festival.slug}`}
            class="flex items-center gap-2 p-3 rounded-sm bg-white hover:bg-saffron-50 transition-colors border border-saffron-100"
          >
            <span class="text-xl">{festival.icon}</span>
            <span class="font-body text-darkbrown/70 text-xs font-medium">{festival.name}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- SEO-Focused Text Section -->
    <div class="my-8 text-center text-darkbrown/50 text-xs font-body">
      <p>
        This comprehensive Q&A resource covers <strong>Hindu religious practices</strong>, including 
        <a href="#diwali" class="text-saffron-600 hover:underline">Diwali significance</a>, 
        <a href="#hinduism" class="text-saffron-600 hover:underline">cow worship in Hinduism</a>, 
        <a href="#mantras" class="text-saffron-600 hover:underline">Gayatri Mantra benefits</a>, 
        <a href="#fasting" class="text-saffron-600 hover:underline">Ekadashi fasting rules</a>, 
        and <a href="#temple-worship" class="text-saffron-600 hover:underline">temple bell significance</a>.
        All answers are rooted in <strong>Vedic scriptures, Puranas, and Hindu tradition</strong>.
      </p>
    </div>

    <!-- Can't Find Answer Section with Internal Link to Pandit Page -->
    <div class="border border-saffron-200 bg-saffron-50/30 rounded-sm p-6 flex flex-col md:flex-row items-center gap-5 mt-8">
      <span class="text-4xl">🙏</span>
      <div class="flex-1 text-center md:text-left">
        <h3 class="font-display text-xl text-darkbrown font-semibold mb-1">Still have questions about Hindu traditions?</h3>
        <p class="text-sm text-darkbrown/60 font-body">
          Ask <strong class="text-saffron-700">Pandit Shivananda</strong> directly. Get personalized answers to your spiritual queries based on authentic scriptures.
        </p>
      </div>
      <a href="/pandit" class="bg-saffron-600 text-white font-sans text-sm font-medium px-5 py-2.5 rounded-sm hover:bg-saffron-700 transition-colors whitespace-nowrap">
        Ask Panditji →
      </a>
    </div>

    <!-- Newsletter / Follow Section -->
    <div class="mt-10 text-center">
      <p class="text-darkbrown/40 text-xs font-body">
        📿 Knowledge is sacred. Share these answers with family and friends to spread understanding of Sanatana Dharma.
      </p>
    </div>
  </div>

  <Footer />
</BaseLayout>

<style is:global>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  html {
    scroll-behavior: smooth;
  }
  
  #searchQuestions {
    transition: all 0.2s ease;
  }
  
  /* Better focus states for accessibility */
  a:focus-visible, button:focus-visible {
    outline: 2px solid #D4A574;
    outline-offset: 2px;
  }
</style>

<script>
  // Search functionality with better UX
  const searchInput = document.getElementById('searchQuestions');
  if (searchInput) {
    const questionCards = document.querySelectorAll('.grid.md\\:grid-cols-2 a');
    const sections = document.querySelectorAll('section');
    
    searchInput.addEventListener('input', function(e) {
      const searchTerm = e.target.value.toLowerCase().trim();
      
      if (searchTerm === '') {
        // Reset all visibility
        questionCards.forEach(card => card.style.display = 'flex');
        sections.forEach(section => section.style.display = 'block');
        return;
      }
      
      let anyVisible = false;
      
      questionCards.forEach(card => {
        const title = card.querySelector('h3')?.innerText.toLowerCase() || '';
        const desc = card.querySelector('p')?.innerText.toLowerCase() || '';
        
        if (title.includes(searchTerm) || desc.includes(searchTerm)) {
          card.style.display = 'flex';
          anyVisible = true;
        } else {
          card.style.display = 'none';
        }
      });
      
      // Hide sections with no visible cards
      sections.forEach(section => {
        const visibleCards = section.querySelectorAll('.grid.md\\:grid-cols-2 a[style="display: flex;"]');
        if (visibleCards.length === 0 && section.id !== 'popular-questions') {
          section.style.display = 'none';
        } else {
          section.style.display = 'block';
        }
      });
      
      // Show no results message (optional)
      const existingMsg = document.querySelector('#no-results-msg');
      if (!anyVisible && !existingMsg) {
        const msg = document.createElement('div');
        msg.id = 'no-results-msg';
        msg.className = 'text-center py-8 text-darkbrown/50';
        msg.innerHTML = '🔍 No questions found. Try a different search term.';
        document.querySelector('.grid.md\\:grid-cols-2')?.parentElement?.appendChild(msg);
      } else if (anyVisible && existingMsg) {
        existingMsg.remove();
      } else if (!anyVisible && existingMsg) {
        // keep it
      }
    });
  }
</script>
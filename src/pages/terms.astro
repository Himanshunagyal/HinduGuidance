---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = "June 1, 2025";
---

<BaseLayout
  title="Terms & Conditions - PanchangSeva"
  description="PanchangSeva Terms and Conditions of use."
>
  <Header />

  <div class="bg-gradient-to-b from-darkbrown to-deepred text-cream py-14">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h1 class="font-display text-4xl font-semibold mb-3">Terms & Conditions</h1>
      <p class="text-cream/60 font-sans text-sm">Last updated: {lastUpdated}</p>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-16 space-y-8">
    {[
      {
        title: "1. Acceptance of Terms",
        content: "By accessing and using PanchangSeva (panchangseva.in), you accept and agree to be bound by these Terms and Conditions. If you do not agree to these terms, please do not use our website."
      },
      {
        title: "2. Nature of Content",
        content: "PanchangSeva provides Hindu spiritual and religious information including vrat calendars, muhurat timings, puja guidance, and AI-assisted spiritual advice. All content is provided for informational and educational purposes only. It is not a substitute for advice from a qualified religious authority or pandit."
      },
      {
        title: "3. AI Pandit Disclaimer",
        content: "Our AI Pandit (Pandit Shivananda) is powered by artificial intelligence and draws from publicly available Vedic and Hindu scriptures. While we strive for accuracy, the AI may make errors. For important religious ceremonies, life decisions, or medical conditions related to fasting, please consult a qualified human pandit or medical professional."
      },
      {
        title: "4. Accuracy of Information",
        content: "We make every effort to ensure that vrat dates, muhurat timings, and spiritual information are accurate. However, regional and calendar variations exist within Hindu traditions. Dates and timings may vary based on your location and local panchangam. PanchangSeva is not liable for any errors or omissions."
      },
      {
        title: "5. Intellectual Property",
        content: "All content on PanchangSeva, including text, design, graphics, and code, is the property of PanchangSeva unless otherwise stated. You may not reproduce, distribute, or use our content commercially without prior written permission."
      },
      {
        title: "6. User Conduct",
        content: "You agree not to misuse the AI Pandit feature for any harmful, abusive, or inappropriate purpose. You agree not to attempt to reverse-engineer, scrape, or overload our systems. Violations may result in access being blocked."
      },
      {
        title: "7. Third-Party Links & Ads",
        content: "Our website may display advertisements through Google AdSense and may contain links to third-party websites. We are not responsible for the content, privacy practices, or accuracy of any third-party sites or advertisements."
      },
      {
        title: "8. Limitation of Liability",
        content: "PanchangSeva and its creators shall not be liable for any direct, indirect, incidental, or consequential damages arising from your use of the website or reliance on its content. Use of this website is at your own risk."
      },
      {
        title: "9. Changes to Terms",
        content: "We reserve the right to modify these Terms at any time. Updated terms will be posted on this page. Continued use of the website after changes are posted constitutes your acceptance of the new terms."
      },
      {
        title: "10. Contact",
        content: "For any questions regarding these Terms & Conditions, please contact us at contact@panchangseva.in."
      }
    ].map(section => (
      <div class="card-sacred p-6">
        <h2 class="font-display text-xl text-darkbrown font-semibold mb-3">{section.title}</h2>
        <p class="font-body text-darkbrown/70 leading-relaxed">{section.content}</p>
      </div>
    ))}
  </div>

  <Footer />
</BaseLayout>
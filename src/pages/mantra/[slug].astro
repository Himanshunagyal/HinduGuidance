---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { mantras } from '../../content/mantras/data';

export const prerender = true;

export async function getStaticPaths() {
  return mantras.map(m => ({ params: { slug: m.slug }, props: { mantra: m } }));
}

const { mantra } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": mantra.faq.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${mantra.title} - Sanskrit, Meaning & Practice`,
  "description": mantra.shortDesc,
  "author": { "@type": "Organization", "name": "PanchangSeva" }
};
---

<BaseLayout
  title={`${mantra.title} - Sanskrit Text, Meaning & How to Chant`}
  description={mantra.shortDesc}
  keywords={mantra.keywords}
  schema={[faqSchema, articleSchema]}
>
  <Header />

  <!-- Breadcrumb -->
  <div class="max-w-4xl mx-auto px-4 pt-6 pb-2">
    <nav class="text-xs font-sans text-darkbrown/50 flex items-center gap-2">
      <a href="/" class="hover:text-saffron-600">Home</a>
      <span>›</span>
      <a href="/mantra" class="hover:text-saffron-600">Mantras</a>
      <span>›</span>
      <span class="text-darkbrown/80">{mantra.title}</span>
    </nav>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-10">

    <!-- Hero -->
    <div class="flex items-start gap-5 mb-8">
      <span class="text-6xl">{mantra.icon}</span>
      <div>
        <h1 class="font-display text-4xl md:text-5xl text-darkbrown font-semibold">{mantra.title}</h1>
        <p class="text-gold font-sans text-sm mt-1">Dedicated to {mantra.deity}</p>
      </div>
    </div>

    <p class="text-darkbrown/70 font-body text-lg leading-relaxed mb-10 border-l-4 border-saffron-300 pl-5 bg-saffron-50/50 py-4 pr-4 rounded-r-sm">
      {mantra.shortDesc}
    </p>

    <!-- Mantras -->
    <h2 class="font-display text-3xl text-darkbrown font-semibold mb-6">The Mantras</h2>
    <div class="space-y-6 mb-10">
      {mantra.mantras.map((m, i) => (
        <div class="card-sacred p-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-7 h-7 rounded-full bg-saffron-100 text-saffron-600 text-xs font-bold flex items-center justify-center">{i + 1}</span>
            <h3 class="font-display text-xl text-darkbrown font-semibold">{m.name}</h3>
          </div>

          <div class="bg-gradient-to-br from-darkbrown to-deepred text-cream rounded-sm p-6 text-center mb-4">
            <p class="sanskrit text-3xl text-gold leading-relaxed mb-3">{m.sanskrit}</p>
            <p class="font-body text-cream/60 italic text-sm">{m.transliteration}</p>
          </div>

          <div class="grid md:grid-cols-2 gap-4 mb-4">
            <div class="bg-saffron-50 p-3 rounded-sm border border-saffron-100">
              <p class="text-xs font-sans text-saffron-600 uppercase tracking-wide mb-1">Chant Count</p>
              <p class="font-body text-darkbrown/80 text-sm">{m.count}</p>
            </div>
            <div class="bg-saffron-50 p-3 rounded-sm border border-saffron-100">
              <p class="text-xs font-sans text-saffron-600 uppercase tracking-wide mb-1">Best Time</p>
              <p class="font-body text-darkbrown/80 text-sm">{m.timing}</p>
            </div>
          </div>

          <p class="font-body text-darkbrown/70 text-sm leading-relaxed"><strong>Benefit:</strong> {m.benefit}</p>
        </div>
      ))}
    </div>

    <!-- Practice Guide -->
    <div class="card-sacred p-6 mb-10">
      <h2 class="font-display text-2xl text-darkbrown font-semibold mb-4">How to Practice</h2>
      <p class="font-body text-darkbrown/70 leading-relaxed">{mantra.practice}</p>
    </div>

    <!-- FAQ -->
    <div class="mb-10">
      <h2 class="font-display text-2xl text-darkbrown font-semibold mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {mantra.faq.map(f => (
          <div class="card-sacred p-5">
            <h3 class="font-display text-lg text-darkbrown font-semibold mb-2">{f.q}</h3>
            <p class="font-body text-darkbrown/70 text-sm leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Ask Pandit CTA -->
    <div class="border border-saffron-200 bg-saffron-50/50 rounded-sm p-6 flex flex-col md:flex-row items-center gap-5">
      <span class="text-4xl">🙏</span>
      <div class="flex-1">
        <h3 class="font-display text-xl text-darkbrown font-semibold mb-1">Have questions about this mantra?</h3>
        <p class="text-sm text-darkbrown/60 font-body">Ask Pandit Shivananda for personalized guidance on mantra practice.</p>
      </div>
      <a href="/pandit" class="bg-saffron-600 text-white font-sans text-sm font-medium px-5 py-2.5 rounded-sm hover:bg-saffron-700 transition-colors whitespace-nowrap">
        Ask Panditji →
      </a>
    </div>
  </div>

  <Footer />
</BaseLayout>
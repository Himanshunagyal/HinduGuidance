---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { vrats } from '../../content/vrats/data';

export const prerender = true;

export async function getStaticPaths() {
  return vrats.map(vrat => ({
    params: { slug: vrat.slug },
    props: { vrat }
  }));
}

const { vrat } = Astro.props;

// FAQ Schema for rich snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What can I eat during ${vrat.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `During ${vrat.name}, you can eat: ${vrat.foods.allowed.join(', ')}. Avoid: ${vrat.foods.avoid.join(', ')}.`
      }
    },
    {
      "@type": "Question",
      "name": `What are the rules of ${vrat.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": vrat.rules.join(' ')
      }
    },
    {
      "@type": "Question",
      "name": `What is the mantra for ${vrat.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The main mantra is: ${vrat.mantra} (${vrat.mantraTransliteration})`
      }
    },
    {
      "@type": "Question",
      "name": `When is the next ${vrat.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The next ${vrat.name} dates are: ${vrat.nextDates.join(', ')}`
      }
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${vrat.name} - Complete Guide with Dates, Rules & Puja Vidhi 2025`,
  "description": `Complete guide for ${vrat.name} including dates, fasting rules, food list, mantra and benefits.`,
  "datePublished": "2025-01-01",
  "dateModified": "2025-06-01",
  "author": { "@type": "Organization", "name": "PanchangSeva" },
  "publisher": { "@type": "Organization", "name": "PanchangSeva", "url": "https://panchangseva.in" }
};

const combinedSchema = [faqSchema, articleSchema];
---

<BaseLayout
  title={`${vrat.name} 2025 - Dates, Rules, Food & Puja Vidhi`}
  description={`${vrat.name} complete guide: upcoming dates in 2025, fasting rules, what to eat, mantra, puja vidhi and benefits. Dedicated to ${vrat.deity}.`}
  keywords={vrat.keywords.join(', ')}
  schema={combinedSchema}
>
  <Header />

  <!-- Breadcrumb -->
  <div class="max-w-4xl mx-auto px-4 pt-6 pb-2">
    <nav class="text-xs font-sans text-darkbrown/50 flex items-center gap-2">
      <a href="/" class="hover:text-saffron-600">Home</a>
      <span>›</span>
      <a href="/vrat" class="hover:text-saffron-600">Vrat Calendar</a>
      <span>›</span>
      <span class="text-darkbrown/80">{vrat.name}</span>
    </nav>
  </div>

  <!-- Hero -->
  <div class="max-w-4xl mx-auto px-4 py-10">
    <div class="flex items-start gap-5 mb-8">
      <span class="text-6xl">{vrat.icon}</span>
      <div>
        <div class="flex items-center gap-3 mb-2">
          <span class="text-xs font-sans text-saffron-600 bg-saffron-50 px-3 py-1 rounded-full border border-saffron-100">{vrat.frequency}</span>
        </div>
        <h1 class="font-display text-4xl md:text-5xl text-darkbrown font-semibold leading-tight">{vrat.name}</h1>
        <p class="text-gold font-sans text-sm mt-1 tracking-wide">Dedicated to {vrat.deity}</p>
      </div>
    </div>

    <p class="text-darkbrown/70 font-body text-lg leading-relaxed mb-8 border-l-4 border-saffron-300 pl-5 bg-saffron-50/50 py-4 pr-4 rounded-r-sm">
      {vrat.description}
    </p>

    <!-- Upcoming Dates -->
    <div class="card-sacred p-6 mb-8">
      <h2 class="font-display text-2xl text-darkbrown font-semibold mb-4">Upcoming {vrat.name} Dates 2025</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {vrat.nextDates.map((date, i) => (
          <div class={`text-center p-3 rounded-sm border ${i === 0 ? 'border-saffron-300 bg-saffron-50' : 'border-gold/20 bg-cream'}`}>
            {i === 0 && <p class="text-xs text-saffron-600 font-sans mb-1">Next</p>}
            <p class={`text-sm font-sans font-medium ${i === 0 ? 'text-saffron-700' : 'text-darkbrown/70'}`}>{date}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Rules -->
    <div class="card-sacred p-6 mb-8">
      <h2 class="font-display text-2xl text-darkbrown font-semibold mb-5">Vrat Rules & Vidhi</h2>
      <ul class="space-y-3">
        {vrat.rules.map((rule, i) => (
          <li class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-saffron-100 text-saffron-600 text-xs font-sans font-bold flex items-center justify-center flex-shrink-0 mt-0.5">{i + 1}</span>
            <span class="text-darkbrown/75 font-body">{rule}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Food Grid -->
    <div class="grid md:grid-cols-2 gap-5 mb-8">
      <div class="bg-green-50 border border-green-100 rounded-sm p-5">
        <h3 class="font-display text-lg text-green-800 font-semibold mb-4">✅ Allowed Foods</h3>
        <ul class="space-y-2">
          {vrat.foods.allowed.map(f => (
            <li class="flex items-center gap-2 text-sm font-body text-green-700">
              <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
              {f}
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-red-50 border border-red-100 rounded-sm p-5">
        <h3 class="font-display text-lg text-red-800 font-semibold mb-4">❌ Foods to Avoid</h3>
        <ul class="space-y-2">
          {vrat.foods.avoid.map(f => (
            <li class="flex items-center gap-2 text-sm font-body text-red-700">
              <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
              {f}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Mantra -->
    <div class="bg-gradient-to-br from-darkbrown to-deepred text-cream rounded-sm p-8 mb-8 text-center">
      <p class="text-gold/60 font-sans text-xs tracking-widest uppercase mb-4">Sacred Mantra</p>
      <p class="sanskrit text-4xl text-gold mb-3">{vrat.mantra}</p>
      <p class="font-body text-cream/60 text-sm italic mb-4">{vrat.mantraTransliteration}</p>
      <p class="text-cream/50 font-sans text-xs">Chant 108 times with mala beads for maximum benefit</p>
    </div>

    <!-- Benefits -->
    <div class="card-sacred p-6 mb-10">
      <h2 class="font-display text-2xl text-darkbrown font-semibold mb-3">Benefits of {vrat.name}</h2>
      <p class="text-darkbrown/70 font-body">{vrat.benefits}</p>
    </div>

    <!-- Ask Pandit CTA -->
    <div class="border border-saffron-200 bg-saffron-50/50 rounded-sm p-6 flex flex-col md:flex-row items-center gap-5">
      <span class="text-4xl">🙏</span>
      <div class="flex-1">
        <h3 class="font-display text-xl text-darkbrown font-semibold mb-1">Have doubts about {vrat.name}?</h3>
        <p class="text-sm text-darkbrown/60 font-body">Ask our AI Panditji — he'll guide you with authentic Vedic wisdom.</p>
      </div>
      <a href="/pandit" class="bg-saffron-600 text-white font-sans text-sm font-medium px-5 py-2.5 rounded-sm hover:bg-saffron-700 transition-colors whitespace-nowrap flex-shrink-0">
        Ask Panditji →
      </a>
    </div>
  </div>

  <Footer />
</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { vrats } from '../content/vrats/data';
import { getTodayPanchang } from '../lib/panchang';

const today = new Date().toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
const todayPanchang = await getTodayPanchang();

const todayMantra = {
  deity: "Lord Vishnu",
  mantra: "ॐ नमो भगवते वासुदेवाय",
  transliteration: "Om Namo Bhagavate Vasudevaya",
  benefit: "Chanting this mantra 108 times today brings peace, removes obstacles, and invites divine blessings into your home.",
};

const upcomingFestivals = [
  { name: "Ekadashi", date: "June 6, 2025", deity: "Lord Vishnu", icon: "🪷" },
  { name: "Pradosh Vrat", date: "June 11, 2025", deity: "Lord Shiva", icon: "🔱" },
  { name: "Purnima", date: "June 11, 2025", deity: "Chandra Dev", icon: "🌕" },
  { name: "Sankashti Chaturthi", date: "June 18, 2025", deity: "Lord Ganesha", icon: "🐘" },
  { name: "Ashadha Ekadashi", date: "June 21, 2025", deity: "Lord Vishnu", icon: "🪷" },
  { name: "Somvar Vrat", date: "June 23, 2025", deity: "Lord Shiva", icon: "🌙" },
];

const homepageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "PanchangSeva - Hindu Vrat Calendar, Muhurat & AI Pandit",
  "description": "Find Vrat dates, auspicious Muhurat timings, Today's Panchang and get answers from our AI Pandit.",
  "url": "https://panchangseva.in"
};
---

<BaseLayout
  title="PanchangSeva - Hindu Vrat Calendar, Panchang & AI Pandit"
  description="Your complete Hindu spiritual guide. Today's Panchang, Tithi, Nakshatra, Rahu Kalam, Ekadashi and Navratri vrat dates, muhurat timings, and AI Pandit guidance."
  schema={homepageSchema}
>
  <Header />

  <!-- Hero Section: Faded Solar System Background with Original Chat Card -->
  <section class="relative overflow-hidden min-h-[95vh] flex items-center text-cream">
    <!-- Deep Space Background -->
    <div class="absolute inset-0 bg-gradient-to-br from-[#050510] via-[#0a0a2a] to-[#0d0d2a]"></div>
    
    <!-- Faded Solar System -->
    <div class="absolute inset-0 pointer-events-none">
      
      <!-- The Sun (very faded, low opacity) -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
        <!-- Outer glow layers - very subtle -->
        <div class="absolute rounded-full bg-orange-500/5 blur-3xl" style="width: 400px; height: 400px; top: -200px; left: -200px;"></div>
        <div class="absolute rounded-full bg-yellow-500/8 blur-2xl" style="width: 250px; height: 250px; top: -125px; left: -125px;"></div>
        <div class="absolute rounded-full bg-orange-400/10 blur-xl" style="width: 150px; height: 150px; top: -75px; left: -75px;"></div>
        <!-- Sun core - very faded -->
        <div class="absolute rounded-full bg-gradient-to-br from-yellow-300/20 via-orange-400/15 to-red-500/10" style="width: 80px; height: 80px; top: -40px; left: -40px; box-shadow: 0 0 40px rgba(255,200,0,0.15);"></div>
      </div>

      <!-- Orbital Paths (clearly visible but subtle) -->
      <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1000 1000" preserveAspectRatio="none">
        <ellipse cx="500" cy="500" rx="120" ry="60" fill="none" stroke="rgba(212,175,55,0.2)" stroke-width="1" stroke-dasharray="4 8" transform="rotate(-10 500 500)" />
        <ellipse cx="500" cy="500" rx="180" ry="90" fill="none" stroke="rgba(212,175,55,0.18)" stroke-width="0.8" stroke-dasharray="3 10" transform="rotate(15 500 500)" />
        <ellipse cx="500" cy="500" rx="250" ry="120" fill="none" stroke="rgba(100,200,255,0.12)" stroke-width="0.8" stroke-dasharray="3 12" transform="rotate(-5 500 500)" />
        <ellipse cx="500" cy="500" rx="320" ry="155" fill="none" stroke="rgba(255,100,80,0.12)" stroke-width="0.8" stroke-dasharray="2 14" transform="rotate(20 500 500)" />
        <ellipse cx="500" cy="500" rx="420" ry="210" fill="none" stroke="rgba(212,175,55,0.1)" stroke-width="0.6" stroke-dasharray="2 18" transform="rotate(-8 500 500)" />
        <ellipse cx="500" cy="500" rx="520" ry="260" fill="none" stroke="rgba(212,175,55,0.08)" stroke-width="0.6" stroke-dasharray="1 20" transform="rotate(12 500 500)" />
      </svg>

      <!-- Planets (faded, subtle) -->
      <div class="absolute rounded-full bg-gradient-to-br from-gray-300/40 to-gray-500/30" style="width: 10px; height: 10px; top: 38%; left: 42%;"></div>
      <div class="absolute rounded-full bg-gradient-to-br from-yellow-300/40 to-amber-600/30" style="width: 14px; height: 14px; top: 32%; left: 58%;"></div>
      <div class="absolute rounded-full bg-gradient-to-br from-blue-400/40 to-green-500/30" style="width: 16px; height: 16px; top: 55%; left: 28%;"></div>
      <div class="absolute rounded-full bg-gradient-to-br from-red-400/40 to-orange-700/30" style="width: 12px; height: 12px; top: 68%; left: 65%;"></div>
      <div class="absolute rounded-full bg-gradient-to-br from-amber-300/30 to-orange-800/25" style="width: 35px; height: 35px; top: 20%; left: 75%;"></div>
      
      <!-- Saturn with faded rings -->
      <div class="absolute" style="top: 75%; left: 80%;">
        <div class="absolute rounded-full bg-gradient-to-br from-yellow-300/35 to-amber-600/25" style="width: 28px; height: 28px; top: -14px; left: -14px;"></div>
        <div class="absolute rounded-full border border-amber-400/20" style="width: 45px; height: 14px; top: -7px; left: -22.5px; transform: rotate(-20deg);"></div>
      </div>
      
      <div class="absolute rounded-full bg-gradient-to-br from-cyan-300/35 to-blue-600/25" style="width: 16px; height: 16px; top: 15%; left: 15%;"></div>
      <div class="absolute rounded-full bg-gradient-to-br from-blue-400/35 to-indigo-800/25" style="width: 14px; height: 14px; top: 85%; left: 12%;"></div>

      <!-- Starfield -->
      <div class="absolute inset-0">
        {[...Array(120)].map((_, i) => (
          <div 
            class="absolute rounded-full bg-white"
            style={{
              top: `${Math.random() * 100}%`,
              left: `${Math.random() * 100}%`,
              width: `${Math.random() * 1.5 + 0.5}px`,
              height: `${Math.random() * 1.5 + 0.5}px`,
              opacity: Math.random() * 0.4 + 0.1,
            }}
          ></div>
        ))}
      </div>

      <!-- Subtle nebula clouds -->
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-purple-600/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-[350px] h-[350px] bg-blue-500/5 rounded-full blur-3xl"></div>
    </div>

    <!-- Floating Divine Symbols -->
    <div class="absolute top-1/4 right-10 text-6xl text-gold/6 animate-float">🕉️</div>
    <div class="absolute bottom-1/3 left-5 text-5xl text-gold/6 animate-float-delayed">ॐ</div>

    <div class="relative max-w-7xl mx-auto px-6 py-20 grid lg:grid-cols-2 gap-16 items-center z-10">
      <div class="space-y-8">
        <div class="inline-flex items-center gap-2 bg-white/8 backdrop-blur-sm rounded-full px-5 py-2 border border-gold/30">
          <span class="w-2 h-2 bg-gold rounded-full animate-pulse"></span>
          <p class="text-gold/80 font-sans text-xs tracking-[0.3em] uppercase">|| SHUBHAM BHAVATU ||</p>
        </div>
        <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-light leading-[1.2] tracking-tight">
          Your Digital<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold via-saffron-400 to-gold font-semibold animate-shimmer">Pandit & Guide</span>
        </h1>
        <p class="text-cream/80 text-xl font-body max-w-lg leading-relaxed">
          Find auspicious Vrat dates, today's Panchang, Muhurat timings, and get answers to your spiritual questions from our learned AI Panditji — rooted in Vedic wisdom.
        </p>
        <div class="flex flex-wrap gap-5 pt-4">
          <a href="/vrat" class="group relative inline-flex items-center gap-2 bg-gradient-to-r from-gold to-saffron-500 text-darkbrown font-sans font-semibold px-8 py-4 rounded-full shadow-xl hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 overflow-hidden">
            <span class="relative z-10">View Vrat Calendar</span>
            <span class="relative z-10 text-lg">→</span>
            <div class="absolute inset-0 bg-gradient-to-r from-saffron-500 to-gold opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </a>
          <a href="/pandit" class="group inline-flex items-center gap-2 border-2 border-gold/40 text-gold font-sans font-semibold px-8 py-4 rounded-full hover:bg-gold/10 transition-all duration-300 hover:border-gold hover:-translate-y-1">
            Ask Panditji
            <span class="text-lg">🕉️</span>
          </a>
        </div>
        <div class="flex items-center gap-8 pt-8 border-t border-gold/30">
          <div class="text-center">
            <p class="text-gold font-display text-3xl font-bold">50+</p>
            <p class="text-cream/50 text-xs font-sans uppercase tracking-wide">Vrat Guides</p>
          </div>
          <div class="w-px h-12 bg-gold/30"></div>
          <div class="text-center">
            <p class="text-gold font-display text-3xl font-bold">365</p>
            <p class="text-cream/50 text-xs font-sans uppercase tracking-wide">Days of Guidance</p>
          </div>
          <div class="w-px h-12 bg-gold/30"></div>
          <div class="text-center">
            <p class="text-gold font-display text-3xl font-bold">AI</p>
            <p class="text-cream/50 text-xs font-sans uppercase tracking-wide">Pandit 24x7</p>
          </div>
        </div>
      </div>

      <!-- Original Chat Card Style (from first version) -->
      <div class="card-sacred p-6 rounded-sm hidden md:block">
        <div class="flex items-center gap-3 mb-5 pb-4 border-b border-gold/20">
          <div class="w-10 h-10 rounded-full bg-saffron-100 flex items-center justify-center">
            <span class="text-xl">🕉️</span>
          </div>
          <div>
            <p class="font-display text-darkbrown font-semibold">Pandit Shivananda</p>
            <p class="text-xs text-saffron-600 font-sans">AI Vedic Pandit • Online</p>
          </div>
          <div class="ml-auto w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
        </div>
        <div class="space-y-3 mb-4">
          <div class="chat-pandit p-3 rounded-sm text-sm text-darkbrown/80 font-body">
            Pranam! I am Pandit Shivananda. How may I guide you on your dharmic path today?
          </div>
          <div class="chat-user p-3 rounded-sm text-sm text-darkbrown/80 text-right font-body">
            Panditji, when is the next Ekadashi and what can I eat?
          </div>
          <div class="chat-pandit p-3 rounded-sm text-sm text-darkbrown/80 font-body">
            Vatsa, the next Ekadashi falls on June 6th. On this sacred day, grains are forbidden. You may take phalahar — fruits, milk, nuts and sago...
          </div>
        </div>
        <a href="/pandit" class="block text-center bg-saffron-50 text-saffron-700 text-sm font-sans font-medium py-2.5 rounded-sm border border-saffron-200 hover:bg-saffron-100 transition-colors">
          Start Conversation →
        </a>
      </div>
    </div>
  </section>

  <!-- UPCOMING FESTIVALS -->
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="flex flex-col md:flex-row justify-between items-end mb-12">
      <div>
        <p class="text-saffron-600 font-sans text-sm tracking-[0.2em] uppercase mb-3 flex items-center gap-2"><span class="w-8 h-px bg-saffron-400"></span> June 2025</p>
        <h2 class="font-display text-4xl md:text-5xl text-darkbrown font-semibold">Upcoming Festivals & Vrats</h2>
        <p class="text-darkbrown/50 font-body mt-2">Mark your calendar for these sacred observances</p>
      </div>
      <a href="/vrat" class="text-saffron-600 font-sans text-sm font-medium hover:underline hidden md:flex items-center gap-1">View Full Calendar <span>→</span></a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {upcomingFestivals.map((fest, i) => (
        <div class={`group relative bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 overflow-hidden ${i === 0 ? 'ring-2 ring-saffron-400 ring-offset-2' : ''}`}>
          <div class="absolute inset-0 bg-gradient-to-br from-gold/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="p-5 flex items-center gap-4">
            <span class="text-4xl transition-transform group-hover:scale-110 duration-300">{fest.icon}</span>
            <div class="flex-1">
              <p class="font-display text-darkbrown font-semibold text-lg">{fest.name}</p>
              <p class="text-xs text-saffron-600 font-sans font-medium">{fest.date}</p>
              <p class="text-xs text-darkbrown/40 font-sans">{fest.deity}</p>
            </div>
            {i === 0 && (
              <span class="bg-saffron-100 text-saffron-700 text-xs font-sans font-semibold px-3 py-1 rounded-full shadow-inner">Next</span>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- TODAY'S MANTRA -->
  <section class="relative py-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-darkbrown via-deepred to-saffron-900"></div>
    <div class="absolute inset-0 opacity-20" style="background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSI0MCIgdmlld0JveD0iMCAwIDQwIDQwIj48Y2lyY2xlIGN4PSIyMCIgY3k9IjIwIiByPSIxIiBmaWxsPSIjZmZkYzAwIiAvPjwvc3ZnPg=='); background-repeat: repeat;"></div>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <div class="inline-block mb-4 px-4 py-1 bg-white/10 backdrop-blur-sm rounded-full border border-gold/30">
        <p class="text-gold/80 font-sans text-xs tracking-wider uppercase">Today's Divine Guidance</p>
      </div>
      <h2 class="font-display text-4xl md:text-5xl text-cream font-semibold mb-8">Daily Mantra</h2>
      <div class="bg-white/5 backdrop-blur-md border border-gold/30 rounded-2xl p-8 md:p-12 shadow-2xl">
        <p class="text-gold/70 font-sans text-sm mb-4">Dedicated to {todayMantra.deity}</p>
        <p class="sanskrit text-5xl md:text-7xl text-gold mb-6 leading-relaxed font-semibold">{todayMantra.mantra}</p>
        <p class="text-cream/60 font-body italic text-xl mb-6">{todayMantra.transliteration}</p>
        <div class="flex justify-center gap-2 mb-6">
          <div class="w-12 h-px bg-gold/40"></div>
          <div class="w-2 h-2 rounded-full bg-gold/60"></div>
          <div class="w-12 h-px bg-gold/40"></div>
        </div>
        <p class="text-cream/80 font-body text-base leading-relaxed max-w-md mx-auto">{todayMantra.benefit}</p>
      </div>
      <a href="/pandit" class="inline-flex items-center gap-2 mt-8 text-gold/70 font-sans text-sm hover:text-gold transition-colors">Ask Panditji about this mantra <span>→</span></a>
    </div>
  </section>

  <!-- WHAT IS PANCHANG -->
  <section class="bg-gradient-to-br from-cream via-saffron-50/20 to-cream py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="w-8 h-px bg-saffron-400"></span>
          <span class="text-saffron-600 text-sm tracking-wider uppercase">Vedic Wisdom</span>
          <span class="w-8 h-px bg-saffron-400"></span>
        </div>
        <h2 class="font-display text-4xl md:text-5xl text-darkbrown font-semibold">The Sacred Panchang</h2>
        <p class="text-darkbrown/50 font-body text-lg mt-3">Understanding the cosmic rhythm</p>
      </div>
      <div class="bg-white rounded-2xl shadow-xl p-6 md:p-10 border border-gold/20">
        <p class="font-body text-darkbrown/80 text-xl leading-relaxed mb-8">
          The word <strong class="text-saffron-700">Panchang</strong> (also spelled Panchanga) comes from Sanskrit — <em class="text-gold">Pancha</em> meaning five, and <em class="text-gold">Anga</em> meaning limb. It is the traditional Hindu almanac that tracks five key elements of each day according to the Vedic calendar system.
        </p>
        <div class="grid md:grid-cols-5 gap-5 mb-8">
          {[
            { name: "Tithi", desc: "Lunar day — the position of the moon relative to the sun" },
            { name: "Vara", desc: "Day of the week — each ruled by a planet and deity" },
            { name: "Nakshatra", desc: "Lunar mansion — the constellation the moon occupies" },
            { name: "Yoga", desc: "A special combination of sun and moon longitudes" },
            { name: "Karana", desc: "Half of a tithi — changes every 6 hours" },
          ].map(item => (
            <div class="text-center p-4 bg-saffron-50 rounded-xl border border-saffron-100 transition-all hover:shadow-md hover:-translate-y-1">
              <p class="font-display text-saffron-700 font-bold text-xl mb-2">{item.name}</p>
              <p class="text-xs text-darkbrown/60 font-body leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
        <div class="space-y-4 text-darkbrown/70 font-body leading-relaxed">
          <p>
            The Panchang has been the backbone of Hindu religious and social life for thousands of years. It is used to determine auspicious days for weddings, business inaugurations, travel, and religious ceremonies. Priests and astrologers consult the Panchang daily to guide devotees on the most harmonious way to align their activities with cosmic rhythms.
          </p>
          <p>
            At <span class="text-saffron-600 font-semibold">PanchangSeva</span>, we present the key Panchang details each day in a simple, accessible format — so every devotee, whether a scholar or a first-time seeker, can navigate their day with dharmic awareness. Understanding your tithi and nakshatra helps you choose the right time for prayer, fasting, and celebrating the divine.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="text-center mb-14">
      <h2 class="font-display text-4xl md:text-5xl text-darkbrown font-semibold mb-3">Sacred Tools for Your Journey</h2>
      <p class="text-darkbrown/60 font-body text-lg max-w-2xl mx-auto">Authentic Vedic guidance, beautifully crafted for the modern devotee</p>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {[
        { icon: "📅", title: "Vrat Calendar", desc: "Complete fasting schedule for the year — Ekadashi, Pradosh, Navratri, Sankashti and more with detailed rules.", href: "/vrat", color: "from-orange-400/10 to-red-400/10" },
        { icon: "⏰", title: "Muhurat Finder", desc: "Find the most auspicious timing for your ceremonies — marriage, grihapravesh, naming ceremony, and more.", href: "/muhurat", color: "from-blue-400/10 to-cyan-400/10" },
        { icon: "🙏", title: "AI Pandit", desc: "Ask our Vedic AI Panditji anything — puja vidhi, mantra meanings, vrat doubts, or spiritual guidance.", href: "/pandit", color: "from-purple-400/10 to-pink-400/10" }
      ].map(f => (
        <a href={f.href} class="group relative bg-white rounded-2xl shadow-md hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 overflow-hidden">
          <div class={`absolute inset-0 bg-gradient-to-br ${f.color} opacity-0 group-hover:opacity-100 transition-opacity`}></div>
          <div class="relative p-8">
            <div class="text-5xl mb-5 transition-transform group-hover:scale-110 inline-block">{f.icon}</div>
            <h3 class="font-display text-2xl text-darkbrown font-semibold mb-3 group-hover:text-saffron-600 transition-colors">{f.title}</h3>
            <p class="text-darkbrown/60 font-body leading-relaxed">{f.desc}</p>
            <div class="mt-6 flex items-center text-saffron-600 font-sans font-medium gap-1 group-hover:gap-2 transition-all">
              <span>Explore</span>
              <span>→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- POPULAR VRATS -->
  <section class="bg-gradient-to-b from-cream via-white to-saffron-50/20 py-20">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12">
        <div>
          <h2 class="font-display text-4xl md:text-5xl text-darkbrown font-semibold">Popular Vrats</h2>
          <p class="text-darkbrown/60 font-body text-lg mt-2">Detailed guides for the most observed fasts</p>
        </div>
        <a href="/vrat" class="text-saffron-600 font-sans text-sm font-medium hover:underline flex items-center gap-1 mt-4 md:mt-0">View All <span>→</span></a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7">
        {vrats.map((vrat, idx) => (
          <a href={`/vrat/${vrat.slug}`} class="group bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-2 overflow-hidden">
            <div class="p-5">
              <div class="flex justify-between items-start mb-4">
                <span class="text-4xl transition-transform group-hover:scale-110 duration-300">{vrat.icon}</span>
                <span class="text-xs font-sans text-saffron-600 bg-saffron-50 px-3 py-1 rounded-full border border-saffron-100 font-medium">{vrat.frequency}</span>
              </div>
              <h3 class="font-display text-xl text-darkbrown font-bold mb-1 group-hover:text-saffron-600 transition-colors">{vrat.name}</h3>
              <p class="text-xs text-gold font-sans mb-3 uppercase tracking-wide">{vrat.deity}</p>
              <p class="text-sm text-darkbrown/60 font-body leading-relaxed line-clamp-2">{vrat.shortDesc.substring(0, 90)}...</p>
              <div class="mt-4 pt-3 border-t border-gold/10 flex justify-between items-center">
                <p class="text-xs font-sans text-darkbrown/50">Next: <span class="text-saffron-600 font-semibold">{vrat.nextDates[0]}</span></p>
                <span class="text-saffron-600 text-sm opacity-0 group-hover:opacity-100 transition-all translate-x-2 group-hover:translate-x-0">Read More →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ASK PANDIT CTA -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-darkbrown via-deepred to-saffron-900"></div>
    <div class="absolute inset-0 opacity-20" style="background: radial-gradient(circle at 20% 40%, rgba(255,215,0,0.2) 0%, transparent 50%);"></div>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <div class="inline-block mb-6 p-4 bg-white/10 backdrop-blur-sm rounded-full">
        <span class="text-6xl">🕉️</span>
      </div>
      <h2 class="font-display text-4xl md:text-6xl text-cream font-semibold mb-5">

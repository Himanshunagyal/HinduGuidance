---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { vrats } from '../content/vrats/data';
import { getTodayPanchang } from '../lib/panchang';

const today = new Date().toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
const todayPanchang = await getTodayPanchang();

const todayMantra = {
  deity: "Lord Vishnu",
  mantra: "ॐ नमो भगवते वासुदेवाय",
  transliteration: "Om Namo Bhagavate Vasudevaya",
  benefit: "Chanting this mantra 108 times today brings peace, removes obstacles, and invites divine blessings into your home.",
};

const upcomingFestivals = [
  { name: "Ekadashi", date: "June 6, 2025", deity: "Lord Vishnu", icon: "🪷" },
  { name: "Pradosh Vrat", date: "June 11, 2025", deity: "Lord Shiva", icon: "🔱" },
  { name: "Purnima", date: "June 11, 2025", deity: "Chandra Dev", icon: "🌕" },
  { name: "Sankashti Chaturthi", date: "June 18, 2025", deity: "Lord Ganesha", icon: "🐘" },
  { name: "Ashadha Ekadashi", date: "June 21, 2025", deity: "Lord Vishnu", icon: "🪷" },
  { name: "Somvar Vrat", date: "June 23, 2025", deity: "Lord Shiva", icon: "🌙" },
];

const homepageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "PanchangSeva - Hindu Vrat Calendar, Muhurat & AI Pandit",
  "description": "Find Vrat dates, auspicious Muhurat timings, Today's Panchang and get answers from our AI Pandit.",
  "url": "https://panchangseva.in"
};
---

<BaseLayout
  title="PanchangSeva - Hindu Vrat Calendar, Panchang & AI Pandit"
  description="Your complete Hindu spiritual guide. Today's Panchang, Tithi, Nakshatra, Rahu Kalam, Ekadashi and Navratri vrat dates, muhurat timings, and AI Pandit guidance."
  schema={homepageSchema}
>
  <Header />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-darkbrown via-deepred to-saffron-900 text-cream min-h-[90vh] flex items-center">
    <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 2px 2px, rgba(201,168,76,0.8) 1px, transparent 0); background-size: 32px 32px;"></div>
    <div class="absolute top-20 right-10 w-72 h-72 rounded-full border border-gold/10 opacity-30 pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-96 h-96 rounded-full border border-saffron-400/10 opacity-20 pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto px-4 py-20 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-gold/70 font-sans text-sm tracking-[0.3em] uppercase mb-4 fade-in-up">|| Shubham Bhavatu ||</p>
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-light leading-tight mb-6 fade-in-up delay-100">
          Your Digital<br/>
          <span class="text-gold-shimmer font-semibold">Pandit & Guide</span>
        </h1>
        <p class="text-cream/70 text-lg font-body mb-8 leading-relaxed max-w-lg fade-in-up delay-200">
          Find auspicious Vrat dates, today's Panchang, Muhurat timings, and get answers to your spiritual questions from our learned AI Panditji — rooted in Vedic wisdom.
        </p>
        <div class="flex flex-wrap gap-3 fade-in-up delay-300">
          <a href="/vrat" class="bg-gradient-to-r from-saffron-500 to-saffron-600 text-white font-sans font-medium px-6 py-3 rounded-sm shadow-lg hover:shadow-saffron-400/30 transition-all hover:-translate-y-0.5">
            View Vrat Calendar
          </a>
          <a href="/pandit" class="border border-gold/40 text-gold font-sans font-medium px-6 py-3 rounded-sm hover:bg-gold/10 transition-all">
            Ask Panditji
          </a>
        </div>
        <div class="flex items-center gap-6 mt-10 fade-in-up delay-300">
          <div class="text-center">
            <p class="text-gold font-display text-2xl font-semibold">50+</p>
            <p class="text-cream/50 text-xs font-sans">Vrat Guides</p>
          </div>
          <div class="w-px h-8 bg-gold/20"></div>
          <div class="text-center">
            <p class="text-gold font-display text-2xl font-semibold">365</p>
            <p class="text-cream/50 text-xs font-sans">Days of Guidance</p>
          </div>
          <div class="w-px h-8 bg-gold/20"></div>
          <div class="text-center">
            <p class="text-gold font-display text-2xl font-semibold">AI</p>
            <p class="text-cream/50 text-xs font-sans">Pandit 24x7</p>
          </div>
        </div>
      </div>

      <div class="card-sacred p-6 rounded-sm hidden md:block fade-in-up delay-200">
        <div class="flex items-center gap-3 mb-5 pb-4 border-b border-gold/20">
          <div class="w-10 h-10 rounded-full bg-saffron-100 flex items-center justify-center">
            <span class="text-xl">🕉️</span>
          </div>
          <div>
            <p class="font-display text-darkbrown font-semibold">Pandit Shivananda</p>
            <p class="text-xs text-saffron-600 font-sans">AI Vedic Pandit • Online</p>
          </div>
          <div class="ml-auto w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
        </div>
        <div class="space-y-3 mb-4">
          <div class="chat-pandit p-3 rounded-sm text-sm text-darkbrown/80 font-body">
            Pranam! I am Pandit Shivananda. How may I guide you on your dharmic path today?
          </div>
          <div class="chat-user p-3 rounded-sm text-sm text-darkbrown/80 text-right font-body">
            Panditji, when is the next Ekadashi and what can I eat?
          </div>
          <div class="chat-pandit p-3 rounded-sm text-sm text-darkbrown/80 font-body">
            Vatsa, the next Ekadashi falls on June 6th. On this sacred day, grains are forbidden. You may take phalahar — fruits, milk, nuts and sago...
          </div>
        </div>
        <a href="/pandit" class="block text-center bg-saffron-50 text-saffron-700 text-sm font-sans font-medium py-2.5 rounded-sm border border-saffron-200 hover:bg-saffron-100 transition-colors">
          Start Conversation →
        </a>
      </div>
    </div>
  </section>

  <!-- UPCOMING FESTIVALS -->
  <section class="max-w-6xl mx-auto px-4 py-14">
    <div class="flex justify-between items-end mb-8">
      <div>
        <p class="text-saffron-600 font-sans text-xs tracking-widest uppercase mb-2">June 2025</p>
        <h2 class="font-display text-4xl text-darkbrown font-semibold">Upcoming Festivals & Vrats</h2>
      </div>
      <a href="/vrat" class="text-saffron-600 font-sans text-sm font-medium hover:underline hidden md:block">View Full Calendar →</a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {upcomingFestivals.map((fest, i) => (
        <div class={`card-sacred p-4 flex items-center gap-4 ${i === 0 ? 'border-l-4 border-saffron-400' : ''}`}>
          <span class="text-3xl">{fest.icon}</span>
          <div>
            <p class="font-display text-darkbrown font-semibold">{fest.name}</p>
            <p class="text-xs text-saffron-600 font-sans">{fest.date}</p>
            <p class="text-xs text-darkbrown/50 font-sans">{fest.deity}</p>
          </div>
          {i === 0 && <span class="ml-auto text-xs bg-saffron-100 text-saffron-700 px-2 py-1 rounded-full font-sans">Next</span>}
        </div>
      ))}
    </div>
  </section>;

  <!-- TODAY'S MANTRA -->
  <section class="bg-gradient-to-br from-darkbrown to-deepred py-14">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="text-gold/60 font-sans text-xs tracking-widest uppercase mb-3">Today's Recommended</p>
      <h2 class="font-display text-3xl text-cream font-semibold mb-6">Daily Mantra</h2>
      <div class="bg-white/5 border border-gold/20 rounded-sm p-8">
        <p class="text-gold/70 font-sans text-xs mb-3">Deity: {todayMantra.deity}</p>
        <p class="sanskrit text-5xl text-gold mb-4 leading-relaxed">{todayMantra.mantra}</p>
        <p class="text-cream/60 font-body italic text-lg mb-5">{todayMantra.transliteration}</p>
        <div class="w-16 h-px bg-gold/30 mx-auto mb-5"></div>
        <p class="text-cream/70 font-body text-sm leading-relaxed max-w-lg mx-auto">{todayMantra.benefit}</p>
      </div>
      <a href="/pandit" class="inline-block mt-6 text-gold/70 font-sans text-sm hover:text-gold">Ask Panditji about this mantra →</a>
    </div>
  </section>



  <!-- WHAT IS PANCHANG -->
  <section class="bg-saffron-50/40 py-14">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-8">
        <h2 class="font-display text-4xl text-darkbrown font-semibold">What is Panchang?</h2>
      </div>
      <div class="card-sacred p-8">
        <p class="font-body text-darkbrown/75 text-lg leading-relaxed mb-5">
          The word <strong>Panchang</strong> (also spelled Panchanga) comes from Sanskrit — <em>Pancha</em> meaning five, and <em>Anga</em> meaning limb. It is the traditional Hindu almanac that tracks five key elements of each day according to the Vedic calendar system.
        </p>
        <div class="grid md:grid-cols-5 gap-4 mb-6">
          {[
            { name: "Tithi", desc: "Lunar day — the position of the moon relative to the sun" },
            { name: "Vara", desc: "Day of the week — each ruled by a planet and deity" },
            { name: "Nakshatra", desc: "Lunar mansion — the constellation the moon occupies" },
            { name: "Yoga", desc: "A special combination of sun and moon longitudes" },
            { name: "Karana", desc: "Half of a tithi — changes every 6 hours approximately" },
          ].map(item => (
            <div class="text-center p-3 bg-saffron-50 rounded-sm border border-saffron-100">
              <p class="font-display text-saffron-700 font-semibold text-lg mb-1">{item.name}</p>
              <p class="text-xs text-darkbrown/60 font-body leading-snug">{item.desc}</p>
            </div>
          ))}
        </div>
        <p class="font-body text-darkbrown/75 leading-relaxed mb-4">
          The Panchang has been the backbone of Hindu religious and social life for thousands of years. It is used to determine auspicious days for weddings, business inaugurations, travel, and religious ceremonies. Priests and astrologers consult the Panchang daily to guide devotees on the most harmonious way to align their activities with cosmic rhythms.
        </p>
        <p class="font-body text-darkbrown/75 leading-relaxed">
          At PanchangSeva, we present the key Panchang details each day in a simple, accessible format — so every devotee, whether a scholar or a first-time seeker, can navigate their day with dharmic awareness. Understanding your tithi and nakshatra helps you choose the right time for prayer, fasting, and celebrating the divine.
        </p>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="max-w-6xl mx-auto px-4 py-14">
    <div class="text-center mb-10">
      <h2 class="font-display text-4xl text-darkbrown font-semibold mb-3">Sacred Tools for Your Spiritual Journey</h2>
      <p class="text-darkbrown/60 font-body text-lg">Everything you need, rooted in authentic Vedic tradition</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {[
        { icon: "📅", title: "Vrat Calendar", desc: "Complete fasting schedule for the year — Ekadashi, Pradosh, Navratri, Sankashti and more with detailed rules.", href: "/vrat" },
        { icon: "⏰", title: "Muhurat Finder", desc: "Find the most auspicious timing for your ceremonies — marriage, grihapravesh, naming ceremony, and more.", href: "/muhurat" },
        { icon: "🙏", title: "AI Pandit", desc: "Ask our Vedic AI Panditji anything — puja vidhi, mantra meanings, vrat doubts, or spiritual guidance.", href: "/pandit" }
      ].map(f => (
        <a href={f.href} class="card-sacred p-7 group">
          <div class="text-4xl mb-4">{f.icon}</div>
          <h3 class="font-display text-xl text-darkbrown font-semibold mb-2 group-hover:text-saffron-600 transition-colors">{f.title}</h3>
          <p class="text-darkbrown/60 font-body text-sm leading-relaxed">{f.desc}</p>
          <p class="mt-4 text-saffron-600 text-sm font-sans font-medium">Explore →</p>
        </a>
      ))}
    </div>
  </section>

  <!-- POPULAR VRATS -->
  <section class="bg-gradient-to-b from-cream to-saffron-50/30 py-14">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex justify-between items-end mb-8">
        <div>
          <h2 class="font-display text-4xl text-darkbrown font-semibold">Popular Vrats</h2>
          <p class="text-darkbrown/60 font-body mt-1">Detailed guides for the most observed fasts</p>
        </div>
        <a href="/vrat" class="text-saffron-600 font-sans text-sm font-medium hover:underline">View All →</a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {vrats.map(vrat => (
          <a href={`/vrat/${vrat.slug}`} class="card-sacred p-5 group">
            <div class="flex justify-between items-start mb-3">
              <span class="text-3xl">{vrat.icon}</span>
              <span class="text-xs font-sans text-saffron-600 bg-saffron-50 px-2 py-1 rounded-sm border border-saffron-100">{vrat.frequency}</span>
            </div>
            <h3 class="font-display text-lg text-darkbrown font-semibold mb-1 group-hover:text-saffron-600 transition-colors">{vrat.name}</h3>
            <p class="text-xs text-gold font-sans mb-2">{vrat.deity}</p>
            <p class="text-sm text-darkbrown/60 font-body leading-relaxed">{vrat.shortDesc.substring(0, 100)}...</p>
            <p class="mt-3 text-xs font-sans text-darkbrown/50">Next: <span class="text-saffron-600 font-medium">{vrat.nextDates[0]}</span></p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ASK PANDIT CTA -->
  <section class="max-w-4xl mx-auto px-4 py-20 text-center">
    <span class="text-5xl block mb-6">🕉️</span>
    <h2 class="font-display text-4xl md:text-5xl text-darkbrown font-semibold mb-4">
      Spiritual Doubts?<br/>Ask Panditji.
    </h2>
    <p class="text-darkbrown/60 font-body text-lg mb-8 max-w-lg mx-auto">
      Our AI Pandit is trained in Vedic scriptures, Puranas, and dharmic traditions. Ask anything — any time.
    </p>
    <a href="/pandit" class="inline-flex items-center gap-3 bg-gradient-to-r from-darkbrown to-deepred text-cream font-sans font-medium px-8 py-4 rounded-sm shadow-xl hover:shadow-darkbrown/30 hover:-translate-y-0.5 transition-all">
      Begin Your Conversation
    </a>
    <p class="mt-4 text-xs text-darkbrown/40 font-sans">Free to use • No registration required</p>
  </section>

  <Footer />
</BaseLayout>
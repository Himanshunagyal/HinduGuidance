---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contact Us - PanchangSeva"
  description="Get in touch with PanchangSeva. We welcome your feedback, suggestions, and queries about our Hindu spiritual guidance platform."
>
  <Header />

  <div class="bg-gradient-to-b from-darkbrown to-deepred text-cream py-14">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h1 class="font-display text-4xl md:text-5xl font-semibold mb-3">Contact Us</h1>
      <p class="text-cream/60 font-body text-lg">We'd love to hear from you</p>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-16">
    <div class="grid md:grid-cols-2 gap-8 mb-10">
      <div class="card-sacred p-6">
        <h2 class="font-display text-xl text-darkbrown font-semibold mb-4">Get In Touch</h2>
        <p class="font-body text-darkbrown/70 text-sm leading-relaxed mb-4">
          Have a suggestion, found an error in our vrat information, or want to collaborate? We're happy to hear from you.
        </p>
        <div class="space-y-3 text-sm font-sans">
          <div class="flex items-center gap-3 text-darkbrown/70">
            <span class="text-saffron-500">📧</span>
            <a href="mailto:contact@panchangseva.in" class="hover:text-saffron-600">contact@panchangseva.in</a>
          </div>
          <div class="flex items-center gap-3 text-darkbrown/70">
            <span class="text-saffron-500">⏱️</span>
            <span>Response within 48 hours</span>
          </div>
        </div>
      </div>

      <div class="card-sacred p-6">
        <h2 class="font-display text-xl text-darkbrown font-semibold mb-4">Write to Us</h2>
        <div class="space-y-3">
          <input
            type="text"
            placeholder="Your Name"
            class="w-full border border-gold/30 rounded-sm px-3 py-2.5 text-sm font-body text-darkbrown bg-cream focus:outline-none focus:border-saffron-400"
          />
          <input
            type="email"
            placeholder="Your Email"
            class="w-full border border-gold/30 rounded-sm px-3 py-2.5 text-sm font-body text-darkbrown bg-cream focus:outline-none focus:border-saffron-400"
          />
          <textarea
            rows="4"
            placeholder="Your Message"
            class="w-full border border-gold/30 rounded-sm px-3 py-2.5 text-sm font-body text-darkbrown bg-cream focus:outline-none focus:border-saffron-400 resize-none"
          ></textarea>
          <a
            href="mailto:contact@panchangseva.in"
            class="block text-center bg-saffron-600 text-white font-sans text-sm font-medium py-2.5 rounded-sm hover:bg-saffron-700 transition-colors"
          >
            Send Message
          </a>
          <p class="text-xs text-darkbrown/40 font-sans text-center">This will open your email client</p>
        </div>
      </div>
    </div>

    <div class="card-sacred p-6 text-center">
      <p class="font-body text-darkbrown/60 text-sm">
        For spiritual questions, please use our <a href="/pandit" class="text-saffron-600 hover:underline">AI Pandit</a> for instant guidance.
      </p>
    </div>
  </div>

  <Footer />
</BaseLayout>